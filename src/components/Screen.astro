---
// Les six écrans du récit, dessinés en HTML/CSS avec les couleurs de l'application (primaire #c3692c).
// Ce sont des illustrations avec des données fictives, pas des captures : à remplacer par de vraies captures
// quand elles existent (voir 11-teaser-content.md). Tailles en unités de conteneur : l'écran se met à
// l'échelle avec le téléphone qui le contient.
import Scene from './Scene.astro';

interface Props {
  name: 'create' | 'before' | 'during' | 'after' | 'sign' | 'pdf';
}
const { name } = Astro.props;
---

<div class={`screen screen--${name}`}>
  {
    name === 'create' && (
      <>
        <header class="bar">
          <span class="back" />
          <h4>Nouveau chantier</h4>
        </header>
        <div class="body">
          <div class="f">
            <span class="lbl">Client</span>
            <div class="ctl">
              Camille Durand
              <span class="chev" />
            </div>
          </div>
          <div class="f">
            <span class="lbl">Adresse du chantier</span>
            <div class="ctl">12 rue des Lilas, Tours</div>
          </div>
          <div class="f">
            <span class="lbl">Titre</span>
            <div class="ctl">Taille de haie et gazon</div>
          </div>
          <div class="f">
            <span class="lbl">Équipe affectée</span>
            <div class="chips">
              <span class="chip on"><i>L</i>Léa</span>
              <span class="chip on"><i>T</i>Tom</span>
              <span class="chip"><i>M</i>Malik</span>
            </div>
          </div>
          <div class="cta">Créer le chantier</div>
        </div>
      </>
    )
  }

  {
    name === 'before' && (
      <>
        <header class="bar">
          <span class="back" />
          <h4>Photos</h4>
        </header>
        <div class="body">
          <div class="seg">
            <span class="on">Avant</span>
            <span>Après</span>
          </div>
          <div class="grid2">
            {[0, 1, 2, 3].map((i) => (
              <div class="ph">
                <Scene kind="before" variant={i} />
              </div>
            ))}
          </div>
          <p class="note">4 photos avant travaux</p>
          <div class="fab">+ Photo</div>
        </div>
      </>
    )
  }

  {
    name === 'during' && (
      <>
        <header class="bar">
          <h4>Chantiers</h4>
        </header>
        <div class="body">
          <div class="card">
            <div class="card__top">
              <b>Haie et pelouse</b>
              <span class="badge badge--run">En cours</span>
            </div>
            <span class="muted">Durand · Tours</span>
            <div class="meter">
              <i style="width: 62%" />
            </div>
          </div>
          <div class="card">
            <div class="card__top">
              <b>Terrasse bois</b>
              <span class="badge">Planifié</span>
            </div>
            <span class="muted">Moreau · Amboise</span>
          </div>
          <div class="card">
            <div class="card__top">
              <b>Plantation haie</b>
              <span class="badge badge--done">Terminé</span>
            </div>
            <span class="muted">Petit · Joué-lès-Tours</span>
          </div>
          <div class="card">
            <div class="card__top">
              <b>Tonte et taille</b>
              <span class="badge badge--done">Terminé</span>
            </div>
            <span class="muted">Bernard · Tours</span>
          </div>
          <div class="fab">+ Chantier</div>
        </div>
      </>
    )
  }

  {
    name === 'after' && (
      <>
        <header class="bar">
          <span class="back" />
          <h4>Rapport de fin de chantier</h4>
        </header>
        <div class="body">
          <span class="lbl">Photos après travaux</span>
          <div class="strip">
            {[0, 1, 2].map((i) => (
              <div class="ph">
                <Scene kind="after" variant={i} />
              </div>
            ))}
          </div>
          <span class="lbl">Commentaire</span>
          <div class="ctl ctl--area">Pelouse semée, haie taillée, déchets évacués. Chantier propre.</div>
          <span class="lbl">Prestations</span>
          <ul class="checks">
            <li><i />Tonte et semis</li>
            <li><i />Taille de haie</li>
            <li><i />Évacuation des déchets</li>
          </ul>
          <div class="cta">Clôturer le chantier</div>
        </div>
      </>
    )
  }

  {
    name === 'sign' && (
      <>
        <header class="bar bar--public">
          <span class="org">Entreprise démo</span>
        </header>
        <div class="body">
          <h5>Réception des travaux</h5>
          <span class="muted">Haie et pelouse · 12 rue des Lilas</span>
          <div class="pair">
            <div class="ph">
              <Scene kind="before" variant={1} />
              <em>Avant</em>
            </div>
            <div class="ph">
              <Scene kind="after" variant={1} />
              <em>Après</em>
            </div>
          </div>
          <ul class="checks checks--big">
            <li><i />Les travaux sont terminés</li>
            <li><i />Ils sont conformes à ma demande</li>
          </ul>
          <div class="pad">
            <svg viewBox="0 0 100 40" aria-hidden="true">
              <path d="M6 28C14 4 22 36 30 16S46 6 52 24 66 34 74 12 90 30 95 20" />
            </svg>
            <span>Signez ici</span>
          </div>
          <div class="cta">Signer</div>
        </div>
      </>
    )
  }

  {
    name === 'pdf' && (
      <>
        <header class="bar">
          <span class="back" />
          <h4>Procès-verbal</h4>
          <span class="badge badge--done">Signé</span>
        </header>
        <div class="body body--paper">
          <div class="paper">
            <div class="paper__head">
              <img src="/brand/mark-navy-sm.webp" width="160" height="133" alt="" />
              <div>
                <b>Procès-verbal de réception</b>
                <span>Haie et pelouse · Durand</span>
              </div>
            </div>
            <div class="lines">
              <i />
              <i />
              <i class="short" />
            </div>
            <div class="pair">
              <div class="ph">
                <Scene kind="before" variant={1} />
                <em>Avant</em>
              </div>
              <div class="ph">
                <Scene kind="after" variant={1} />
                <em>Après</em>
              </div>
            </div>
            <div class="lines">
              <i />
              <i class="short" />
            </div>
            <div class="sig">
              <svg viewBox="0 0 100 40" aria-hidden="true">
                <path d="M6 28C14 4 22 36 30 16S46 6 52 24 66 34 74 12 90 30 95 20" />
              </svg>
              <span>Travaux acceptés · signé</span>
            </div>
          </div>
        </div>
      </>
    )
  }
</div>

<style>
  .screen {
    --app-primary: #c3692c;
    --app-fg: #0f172a;
    --app-muted: #64748b;
    --app-border: #e2e8f0;
    --app-soft: #f8fafc;
    --app-ok: #1f8a54;

    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    font-size: 4.3cqw;
    line-height: 1.3;
    color: var(--app-fg);
    background: var(--app-soft);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 2.5cqw;
    padding: 14cqw 4.5cqw 3.2cqw;
    background: #fff;
    border-bottom: 1px solid var(--app-border);
  }

  .bar h4 {
    margin: 0;
    flex: 1;
    font-size: 1.12em;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .bar--public {
    justify-content: center;
  }

  .org {
    font-weight: 800;
    font-size: 1.05em;
    letter-spacing: 0.02em;
    color: var(--app-primary);
  }

  .back {
    width: 2.4cqw;
    height: 2.4cqw;
    margin-left: 0.8cqw;
    border-left: 0.7cqw solid var(--app-fg);
    border-bottom: 0.7cqw solid var(--app-fg);
    transform: rotate(45deg);
  }

  .body {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2.6cqw;
    padding: 4.5cqw;
    overflow: hidden;
  }

  .lbl {
    font-size: 0.86em;
    font-weight: 600;
    color: var(--app-muted);
  }

  .muted {
    font-size: 0.86em;
    color: var(--app-muted);
  }

  .f {
    display: grid;
    gap: 1.2cqw;
  }

  .ctl {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 9.5cqw;
    padding: 1.8cqw 3cqw;
    border: 1px solid var(--app-border);
    border-radius: 2.4cqw;
    background: #fff;
  }

  .ctl--area {
    align-items: flex-start;
    min-height: 17cqw;
    font-size: 0.92em;
    line-height: 1.4;
  }

  .chev {
    width: 2cqw;
    height: 2cqw;
    margin-top: -0.8cqw;
    border-right: 0.6cqw solid var(--app-muted);
    border-bottom: 0.6cqw solid var(--app-muted);
    transform: rotate(45deg);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 2cqw;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 1.6cqw;
    padding: 1.2cqw 3cqw 1.2cqw 1.4cqw;
    border: 1px solid var(--app-border);
    border-radius: 99px;
    background: #fff;
    font-size: 0.92em;
  }

  .chip i {
    display: grid;
    place-items: center;
    width: 6cqw;
    height: 6cqw;
    border-radius: 50%;
    font-style: normal;
    font-size: 0.82em;
    font-weight: 700;
    color: var(--app-muted);
    background: var(--app-border);
  }

  .chip.on {
    border-color: var(--app-primary);
    background: #fbefe6;
  }

  .chip.on i {
    color: #fff;
    background: var(--app-primary);
  }

  .cta {
    margin-top: auto;
    padding: 3.2cqw;
    border-radius: 2.6cqw;
    text-align: center;
    font-weight: 700;
    color: #fff;
    background: var(--app-primary);
  }

  /* avant */
  .seg {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 0.9cqw;
    border-radius: 2.6cqw;
    background: #e8edf3;
    text-align: center;
    font-weight: 600;
    font-size: 0.92em;
  }

  .seg span {
    padding: 1.8cqw;
    border-radius: 2cqw;
    color: var(--app-muted);
  }

  .seg .on {
    color: var(--app-fg);
    background: #fff;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.15);
  }

  .grid2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.4cqw;
  }

  .ph {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 2.4cqw;
  }

  .ph em {
    position: absolute;
    left: 1.6cqw;
    bottom: 1.6cqw;
    padding: 0.5cqw 2cqw;
    border-radius: 99px;
    font-style: normal;
    font-size: 0.78em;
    font-weight: 700;
    color: #fff;
    background: rgba(15, 23, 42, 0.7);
  }

  .note {
    margin: 0;
    text-align: center;
    font-size: 0.86em;
    color: var(--app-muted);
  }

  .fab {
    position: absolute;
    right: 4.5cqw;
    bottom: 5cqw;
    padding: 3cqw 5cqw;
    border-radius: 99px;
    font-weight: 700;
    color: #fff;
    background: var(--app-primary);
    box-shadow: 0 8px 18px -6px rgba(195, 105, 44, 0.8);
  }

  /* suivi */
  .card {
    display: grid;
    gap: 1.4cqw;
    padding: 3.4cqw;
    border: 1px solid var(--app-border);
    border-radius: 3cqw;
    background: #fff;
  }

  .card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2cqw;
  }

  .badge {
    flex: none;
    padding: 0.7cqw 2.4cqw;
    border-radius: 99px;
    font-size: 0.8em;
    font-weight: 700;
    color: #475569;
    background: #e8edf3;
  }

  .badge--run {
    color: #fff;
    background: var(--app-primary);
  }

  .badge--done {
    color: #14633c;
    background: #d9f2e3;
  }

  .meter {
    height: 1.6cqw;
    margin-top: 0.8cqw;
    border-radius: 99px;
    background: #e8edf3;
    overflow: hidden;
  }

  .meter i {
    display: block;
    height: 100%;
    border-radius: 99px;
    background: var(--app-primary);
  }

  /* après / signature */
  .strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2cqw;
  }

  .checks {
    display: grid;
    gap: 2cqw;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .checks li {
    display: flex;
    align-items: center;
    gap: 2.4cqw;
    font-size: 0.92em;
  }

  .checks i {
    position: relative;
    flex: none;
    width: 5cqw;
    height: 5cqw;
    border-radius: 1.4cqw;
    background: var(--app-ok);
  }

  .checks i::after {
    content: '';
    position: absolute;
    left: 1.7cqw;
    top: 0.9cqw;
    width: 1.3cqw;
    height: 2.5cqw;
    border-right: 0.7cqw solid #fff;
    border-bottom: 0.7cqw solid #fff;
    transform: rotate(40deg);
  }

  .checks--big {
    padding: 3cqw;
    border: 1px solid var(--app-border);
    border-radius: 3cqw;
    background: #fff;
  }

  h5 {
    margin: 0;
    font-size: 1.2em;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2cqw;
  }

  .pair .ph {
    aspect-ratio: 4 / 3;
  }

  .pad {
    position: relative;
    height: 21cqw;
    border: 1.5px dashed #c5cdd8;
    border-radius: 3cqw;
    background: #fff;
  }

  .pad svg {
    position: absolute;
    inset: 2cqw 6cqw 4cqw;
    width: calc(100% - 12cqw);
    height: calc(100% - 6cqw);
  }

  .pad path,
  .sig path {
    fill: none;
    stroke: #032042;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pad span {
    position: absolute;
    left: 3cqw;
    bottom: 1.4cqw;
    font-size: 0.75em;
    color: var(--app-muted);
  }

  /* procès-verbal */
  .body--paper {
    background: #e8edf3;
    padding: 5cqw 5.5cqw;
  }

  .paper {
    display: grid;
    gap: 3cqw;
    padding: 4.5cqw;
    border-radius: 1.6cqw;
    background: #fff;
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.12),
      0 10px 22px -10px rgba(15, 23, 42, 0.4);
  }

  .paper__head {
    display: flex;
    align-items: center;
    gap: 3cqw;
    padding-bottom: 3cqw;
    border-bottom: 1px solid var(--app-border);
  }

  .paper__head img {
    flex: none;
    width: 11cqw;
    height: auto;
  }

  .paper__head div {
    display: grid;
    line-height: 1.25;
  }

  .paper__head b {
    font-size: 0.95em;
    letter-spacing: -0.01em;
  }

  .paper__head span {
    font-size: 0.78em;
    color: var(--app-muted);
  }

  .lines {
    display: grid;
    gap: 1.6cqw;
  }

  .lines i {
    display: block;
    height: 1.7cqw;
    border-radius: 99px;
    background: #e4e9f0;
  }

  .lines i.short {
    width: 62%;
  }

  .sig {
    display: grid;
    justify-items: start;
    padding-top: 2cqw;
  }

  .sig svg {
    width: 38cqw;
    height: 12cqw;
  }

  .sig span {
    font-size: 0.78em;
    font-weight: 600;
    color: var(--app-ok);
  }
</style>
